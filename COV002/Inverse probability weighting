# 5. Forest plot models

```{r create forest data}
#run model for intended forest plot
#mod_sum<-summary(mod_neut)
mod_sum<-summary(mod_S)
tab_mod<-round(mod_sum$coefficients, digits=3)
cbind(exp(tab_mod[,1:2]), tab_mod[,4])

forest_dat<-as.data.frame(tab_mod[,c(1,2,4)])
forest_dat$OR<-exp(forest_dat$Estimate)
forest_dat$uci<-exp(forest_dat$Estimate+(1.96*forest_dat$`Std. Error`))
forest_dat$lci<-exp(forest_dat$Estimate-(1.96*forest_dat$`Std. Error`))
forest_dat$covariates<-rownames(forest_dat)
forest_dat$covariates <- as.character(forest_dat$covariates)
forest_dat$covariates <- factor(forest_dat$covariates, levels=unique(forest_dat$covariates))
```

