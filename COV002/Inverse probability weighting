#2. Run models

Inverse probability weighting. Immune marker data were not available for everyone in the correlates population, and cases are over-represented in the immune marker datasets as these were preferentially processed over noncases. Unadjusted estimates of absolute risk of infection will therefore be inflated and result in bias to correlates estimates. We used a logistic regression model to predict the probability that a participant will have immune marker data available to the analysis. The outcome variables were each immune marker, and predictors were:

- age group (18–55 years, 56–69 years, 70 years or above)
- whether the participant is a case or noncase, the type of case (primary symptomatic, non-primary symptomatic, asymptomatic - now removed non-primary but this could change)
- prime-boost interval (<6 weeks/ 6-8 weeks/ 9-11 weeks/ >=12 weeks)
- dosage (LD/LD, LD/SD, SD/SD).

An additional predictor used in this model but was not used in the Feng model because they focus on the vaccine arm only, is trial arm.

The inverse probability from this model was used to weight the correlates of risk models for each immune marker to remove this source of bias (Supplementary Table 3).


```{r model - oxford}
#Neuts
mod_neut<-glm(neut_yn ~ age_cat_cor + outcome + interval.prime.cutoff + endpoint.dose + vaccinated + vaccinated*outcome, data=model_data, family = "binomial")
summary(mod_neut)
log_odds<-mod_neut$coef
odds<-exp(mod_neut$coef)
std_errors<-summary(mod_neut)$coefficients[,2]
p_vals<-summary(mod_neut)$coefficients[,4]
uppers<-odds+1.96*std_errors
lowers<-odds-1.96*std_errors
(neut_modsumdat<-round(data.frame(odds, lowers, uppers, p_vals), digits=3))
#write.csv(neut_modsumdat, "C:/Users/lrw19/OneDrive - Imperial College London/Documents/PhD Project/RStan Model/Correlates of protection/Correlates COV002/neut_modsumdat.csv")

#Spike

#note there are no LD/LD participants with spike/rbd antibody measurements. Therefore in these models I use an endpoint.dose variable that combines LD/LD and LD/SD
mod_S<-glm(igg.s_yn ~ age_cat_cor + outcome + interval.prime.cutoff + endpoint.dose.sdld + vaccinated + vaccinated*outcome, data=model_data, family = "binomial")
summary(mod_S)
log_odds<-mod_S$coef
odds<-exp(mod_S$coef)
std_errors<-summary(mod_S)$coefficients[,2]
p_vals<-summary(mod_S)$coefficients[,4]
uppers<-odds+1.96*std_errors
lowers<-odds-1.96*std_errors
(spike_modsumdat<-round(data.frame(odds, lowers, uppers, p_vals), digits=3))
#write.csv(spike_modsumdat, "C:/Users/lrw19/OneDrive - Imperial College London/Documents/PhD Project/RStan Model/Correlates of protection/Correlates COV002/spike_modsumdat.csv")

#RBD
mod_RBD<-glm(igg.RBD_yn ~ age_cat_cor + outcome + interval.prime.cutoff + endpoint.dose.sdld + vaccinated + vaccinated*outcome, data=model_data, family = "binomial")
summary(mod_RBD)
log_odds<-mod_RBD$coef
odds<-exp(mod_RBD$coef)
std_errors<-summary(mod_RBD)$coefficients[,2]
p_vals<-summary(mod_RBD)$coefficients[,4]
uppers<-odds+1.96*std_errors
lowers<-odds-1.96*std_errors
round(data.frame(log_odds, odds, lowers, uppers, p_vals), digits=3)
#spike and rbd are the same so use spike for rbd
```



#3. Generate weights
```{r neut weights - oxford}
model_data$fitted_value<-mod_neut$fitted.values
model_data$neut_weight<- 1/(mod_neut$fitted.values)
ggplot(model_data, aes(x=neut_weight))+
        geom_histogram()+
        labs(x="Weight (neutralising antibodies)", y="Count")+
        theme_bw()+
  coord_cartesian(xlim = c(0,25), ylim=c(0,1500))
summary(model_data$neut_weight)
quantile(model_data$neut_weight, 0.025)
quantile(model_data$neut_weight, 0.975)
```

```{r Spike weights - oxford}
#spike and RBD are the same
model_data$fitted_value<-mod_S$fitted.values
model_data$spike_rbd_weight<- 1/(mod_S$fitted.values)
ggplot(model_data, aes(x=spike_rbd_weight))+
        geom_histogram()+
        labs(x="Weight (Spike and RBD IgG antibodies)", y="Count")+
        theme_bw()+
  coord_cartesian(xlim = c(0,25), ylim=c(0,1500))
summary(model_data$spike_rbd_weight)
quantile(model_data$spike_rbd_weight, 0.025)
quantile(model_data$spike_rbd_weight, 0.975)
```

