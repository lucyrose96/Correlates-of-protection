### Setup data for CoP simulation model ###


#1. Setup
library(tidyverse)
library("FamilyRank")
set.seed(1)

#2. Set common parameters

scenario="two" #scenario 2 parameters - modify for each scenario
num_sims=1000 #number of simulations (same for all scenarios)
num_subjects<-  10000 #sample size (same for all scenarios)
nrows=num_sims*num_subjects
lam<-c(0.3,0.3) #Force of infection (same for all scenarios)

#scenario 2 parameters - modify for each scenario
kk_in=2 
n_50_in= 2 
scale_vein=1 
VE_direct_in<-0 
p_direct_in=VE_direct_in/scale_vein #for scenarios where scale = 0, set p_direct to 0 (otherwise will give an error for dividing by 0)

kk_pr=2
n_50_pr= 0
scale_vepr=1
VE_direct_pr<-0
p_direct_pr=VE_direct_pr/scale_vepr #for scenarios where scale = 0, set p_direct to 0 (otherwise will give an error for dividing by 0)

#3. Create data frame for vaccine and placebo arms

## age = age group, arm = trial arm, "A" = number of asymptomatic infections, "C" = number of symptomatic infections, age_code = age group (indicator variable), "s" = CoP value, "ve_in" = vaccine efficacy against infection, "ve_pr" = vaccine efficacy against progression to symptoms, "sim" = simulation number, "ps" = probability of symptoms (without vaccination), arm_01 = trial arm (indicator variable)
## note we assumed the same parameters for each age group throughout our analyses, this code allows for modification to relax this assumption

c_v<-data.frame(matrix(nrow = nrows/2, ncol=9, data = NA ))
colnames(c_v)<-c("age","arm","A","C","age_code","s", "ve_in", "ve_pr", "sim")
c_v$age_code<-floor(runif(nrows/2)*4/3)+1
c_v$age<-c("18-64","65+")[c_v$age_code]
c_v$ps<-c(0.5,0.5)[c_v$age_code]
c_v$sim<- rep(1:num_sims, each =num_subjects/2)

c_p<-data.frame(matrix(nrow = nrows/2, ncol=9, data = NA ))
colnames(c_p)<-c("age","arm","A","C","age_code","s", "ve_in", "ve_pr", "sim")
c_p$age_code<-floor(runif(nrows/2)*4/3)+1
c_p$age<-c("18-64","65+")[c_p$age_code]
c_p$ps<-c(0.5,0.5)[c_p$age_code]
c_p$sim<- rep(1:num_sims, each =num_subjects/2)

c_v$arm<-"V"
c_p$arm<-"P"

c_v$arm_01<-1
c_p$arm_01<-0


# 4. Simulate antibody and vaccine efficacy

c_v$s <- rbinorm(n=length(c_v$s), mean1=0, mean2=-8, sd1=1.5, sd2=1, prop=0.8) #vaccine arm distribution is bimodal
c_p$s[1:(nrow(c_p))]= rnorm(n = length(c_p$s), mean = -8, sd = 1) #placebo participants distribution is the same as the non-responders

c_v$ve_in<-  (p_direct_in*scale_vein+((1-p_direct_in)*scale_vein)*(((1/(1+exp(-kk_in*(c_v$s-n_50_in))))))) *as.integer(c_v$arm=="V")
c_v$ve_pr<-  (p_direct_pr*scale_vepr+((1-p_direct_pr)*scale_vepr)*(((1/(1+exp(-kk_pr*(c_v$s-n_50_pr))))))) *as.integer(c_v$arm=="V")
c_v$ve_sym<- 1-(1-c_v$ve_in)*(1-c_v$ve_pr)
c_v$ve_asym<- 1-((1-c_v$ve_in)-(c_v$ps)*(1-c_v$ve_in)*(1-c_v$ve_pr))/(1-c_v$ps)

c_p$ve_in<- 0
c_p$ve_pr<-  0
c_p$ve_sym<- 0
c_p$ve_asym<- 0
  
  
# 5. Simulate N cases

  c_p<-c_p%>%
  mutate(C = rpois(lam*c_p$ps, n=nrow(c_p)),
         A = rpois(lam*(1-c_p$ps), n=nrow(c_p)),
         Total = C+A
  )
  
  c_v<-c_v%>%
    mutate(C = rpois((1-c_v$ve_in)*(1-c_v$ve_pr)*lam*c_v$ps, n=nrow(c_v)),
           A = rpois((1-c_v$ve_in)*lam*((1-c_v$ps)+c_v$ps*c_v$ve_pr), n=nrow(c_v)),
           Total = C+A
    )



# e. Join trial arms to one dataset and add variables for analysis
  c<-rbind(c_p, c_v)
  c$scenario<-scenario
  c$lloq<- -5 # assuming lower limit of quantification is -5
  c$zero<- 0
  #marker at different parts of the CoP distribution
  c$perc50<-quantile(c$s[which(c$arm == "V")], 0.50)
  c$perc60<-quantile(c$s[which(c$arm == "V")], 0.60)
  c$perc70<-quantile(c$s[which(c$arm == "V")], 0.70)
  c$perc80<-quantile(c$s[which(c$arm == "V")], 0.80)
  c$perc90<-quantile(c$s[which(c$arm == "V")], 0.90)
  c$perc95<-quantile(c$s[which(c$arm == "V")], 0.95)
  c$VE_direct_in<-VE_direct_in
  c$VE_direct_pr<-VE_direct_pr

  
#3. Split datasets for each simulation
    
  split_datasets <- split(c, c$sim)
  
    # Loop through the list of datasets and save each one separately
    for (i in 1:length(split_datasets)) {
      # Get the current dataset
      current_dataset <- split_datasets[[i]]
      # Generate the filename for saving (e.g., c_1.csv, c_2.csv, ..., c_1000.csv)
      filename <- paste0("c_", i, ".csv")
      # Save the current dataset to a CSV file
      write.csv(current_dataset, file = filename, row.names = FALSE)
    }
